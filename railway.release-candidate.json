{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python manage.py collectstatic --noinput"
  },
  "deploy": {
    "preDeployCommand": "python manage.py bootstrap_mcp_source_schema --with-sample && python manage.py migrate --noinput",
    "startCommand": "python -m uvicorn config.asgi:application --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers",
    "healthcheckPath": "/health/ready/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
