# Safe local defaults. Copy to .env.local; never put production credentials here.
OPENSKAGIT_ENVIRONMENT=development
DEBUG=true
OPENSKAGIT_LOCAL_SECRET_KEY=local-only-development-key-change-if-shared
OPENSKAGIT_LOCAL_PUBLIC_ORIGIN=http://127.0.0.1:8000

# Separate PostGIS databases. Compose exposes only loopback port 55432.
DATABASE_URL=postgresql://openskagit_local:openskagit_local@127.0.0.1:55432/openskagit_dev
OPENSKAGIT_TEST_DATABASE_URL=postgresql://openskagit_local:openskagit_local@127.0.0.1:55432/openskagit_test

# Local HTTP and OAuth boundaries.
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
OPENSKAGIT_MCP_CONNECTOR_URL=http://127.0.0.1:8000/mcp/api/
VALHALLA_URL=

# No external notifications, storage, telemetry, or live-source calls by default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=
BUDGET_PDF_STORAGE=local
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_DEBUG_ROUTE=false
OPENSKAGIT_ENABLE_LIVE_TOOLS=false
OPENSKAGIT_ALLOW_LIVE_SOURCE_CALLS=false

# Optional application integrations stay disabled until a bounded test needs them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CENSUS_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
TAXSHIFT_TURNSTILE_SITE_KEY=
TAXSHIFT_TURNSTILE_SECRET_KEY=

# Existing application defaults used by local pages.
SITE_URL=http://127.0.0.1:8000/opportunity
TAXSHIFT_SITE_URL=http://127.0.0.1:8000
DUCKDB_USE_POSTGRES=true
OPPORTUNITY_EVALS_LIVE=0
CONTEXT_MCP_TIMEOUT_SECONDS=25
